# Use "demo" for the zero-setup in-memory showcase, or "cognodb" for CognoDB Cloud.
DATA_SOURCE=demo

# Required when DATA_SOURCE=cognodb.
COGNODB_URI=bolt+s://your-instance-id.databases.cognodb.com
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=replace-with-the-password-shown-once
COGNODB_DATABASE=continuum-supply-graph
