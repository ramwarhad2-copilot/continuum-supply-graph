{
  "name": "continuum-graph",
  "version": "1.0.0",
  "private": true,
  "description": "A graph-powered medicine supply resilience explorer built for CognoDB.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "package:worker": "wrangler deploy --dry-run --outdir dist",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "lucide-react": "1.30.0",
    "neo4j-driver": "6.2.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "jsdom": "27.2.0",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "^4.120.0"
  }
}
